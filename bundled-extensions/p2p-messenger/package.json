{
  "name": "p2p-messenger",
  "displayName": "P2P 메신저",
  "description": "폐쇄망 환경을 위한 호스트/게스트 방식 P2P 메신저",
  "version": "1.0.1",
  "publisher": "docwatch",
  "license": "pro",
  "icon": "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"12\" cy=\"12\" r=\"10\" fill=\"#667eea\" stroke=\"none\"/><rect x=\"5\" y=\"6\" width=\"8\" height=\"6\" rx=\"1\" fill=\"white\"/><polygon points=\"7,12 7,15 10,12\" fill=\"white\"/><rect x=\"11\" y=\"9\" width=\"8\" height=\"6\" rx=\"1\" fill=\"white\" opacity=\"0.9\"/><polygon points=\"17,15 17,18 14,15\" fill=\"white\" opacity=\"0.9\"/></svg>",
  "categories": ["Communication", "Networking"],
  "keywords": ["p2p", "messenger", "chat", "file-transfer"],
  "engines": {
    "docwatch": "^1.0.0"
  },
  "activationEvents": ["*"],
  "main": "extension.js",
  "contributes": {
    "activityBar": [
      {
        "id": "p2p-messenger",
        "title": "P2P 메신저",
        "icon": "$(comment-discussion)",
        "section": "messenger"
      }
    ],
    "sections": [
      {
        "id": "messenger",
        "title": "메신저",
        "icon": "$(comment-discussion)"
      }
    ],
    "commands": [
      {
        "id": "p2p-messenger.startHost",
        "title": "호스트 시작",
        "icon": "$(server)"
      },
      {
        "id": "p2p-messenger.stopHost",
        "title": "호스트 중지",
        "icon": "$(debug-stop)"
      },
      {
        "id": "p2p-messenger.connect",
        "title": "서버 연결",
        "icon": "$(plug)"
      },
      {
        "id": "p2p-messenger.disconnect",
        "title": "연결 해제",
        "icon": "$(debug-disconnect)"
      },
      {
        "id": "p2p-messenger.sendMessage",
        "title": "메시지 전송",
        "icon": "$(send)"
      },
      {
        "id": "p2p-messenger.sendFile",
        "title": "파일 전송",
        "icon": "$(file)"
      },
      {
        "id": "p2p-messenger.openDownloads",
        "title": "다운로드 폴더 열기",
        "icon": "$(folder-opened)"
      }
    ],
    "statusBar": [
      {
        "id": "p2p-status",
        "alignment": "right",
        "priority": 100,
        "text": "P2P: 오프라인",
        "tooltip": "P2P 메신저 상태"
      }
    ],
    "configuration": {
      "title": "P2P 메신저 설정",
      "properties": {
        "p2p-messenger.defaultPort": {
          "type": "number",
          "default": 9900,
          "description": "기본 호스트 포트"
        },
        "p2p-messenger.nickname": {
          "type": "string",
          "default": "User",
          "description": "기본 닉네임"
        },
        "p2p-messenger.autoReconnect": {
          "type": "boolean",
          "default": true,
          "description": "연결 끊김 시 자동 재연결"
        }
      }
    }
  },
  "permissions": [
    "ipc",
    "ui",
    "storage",
    "commands"
  ]
}
