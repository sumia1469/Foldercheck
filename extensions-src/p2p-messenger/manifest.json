{
  "id": "p2p-messenger",
  "name": "P2P 메신저",
  "version": "1.0.0",
  "description": "폐쇄망용 호스트/게스트 방식 P2P 메신저 및 클라우드 파일 서버",
  "author": "DocWatch Team",
  "main": "p2p-messenger.js",
  "preload": "preload-chat.js",
  "ui": {
    "chatWindow": "public/chat-window.html"
  },
  "activationEvents": [
    "onCommand:openMessenger",
    "onMenu:messenger"
  ],
  "permissions": [
    "network",
    "filesystem",
    "notifications"
  ],
  "minAppVersion": "1.0.0",
  "dependencies": {},
  "files": [
    "p2p-messenger.js",
    "messenger-db.js",
    "preload-chat.js",
    "public/**/*"
  ],
  "contributes": {
    "menus": [
      {
        "id": "messenger-menu",
        "title": "메신저",
        "icon": "💬",
        "location": "sidebar",
        "order": 100
      }
    ],
    "sections": [
      {
        "id": "messenger-section",
        "menuId": "messenger-menu",
        "template": "messenger-section-template",
        "styles": "public/css/messenger.css"
      }
    ],
    "commands": [
      {
        "id": "p2p-messenger.openChat",
        "title": "채팅 열기"
      },
      {
        "id": "p2p-messenger.startHost",
        "title": "호스트 시작"
      },
      {
        "id": "p2p-messenger.stopHost",
        "title": "호스트 중지"
      }
    ]
  }
}
