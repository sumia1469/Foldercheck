{
  "name": "docwatch",
  "version": "1.0.0",
  "description": "기획자를 위한 로컬 업무 자동화 도구 - 폴더 감시부터 회의록까지",
  "main": "main.js",
  "scripts": {
    "start": "open ./node_modules/electron/dist/Electron.app --args .",
    "start:alt": "electron .",
    "start:win": "chcp 65001 >nul && electron .",
    "start:mac": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win && node scripts/apply-icon.js --rebuild-installer",
    "build:win:noicon": "electron-builder --win",
    "apply-icon": "node scripts/apply-icon.js",
    "build:mac": "electron-builder --mac",
    "build:all": "electron-builder --win --mac",
    "build:portable": "electron-builder --win portable",
    "build:extensions": "node scripts/build-extensions.js",
    "build:all-with-ext": "npm run build:extensions && npm run build:all"
  },
  "author": "DocWatch Team",
  "license": "MIT",
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "electron": "^33.4.11",
    "electron-builder": "^24.9.1",
    "png-to-ico": "^3.0.1",
    "rcedit": "^5.0.2",
    "sharp": "^0.34.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sumia1469/docwatch.git"
  },
  "build": {
    "appId": "app.docwatch.desktop",
    "productName": "DocWatch",
    "publish": {
      "provider": "github",
      "owner": "sumia1469",
      "repo": "docwatch",
      "releaseType": "release"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icons/icon.ico",
      "signAndEditExecutable": false,
      "requestedExecutionLevel": "asInvoker",
      "publish": [
        "github"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DocWatch",
      "installerLanguages": [
        "ko-KR",
        "en-US"
      ],
      "language": "1042",
      "packElevateHelper": false,
      "unicode": true
    },
    "compression": "store",
    "files": [
      "main.js",
      "preload.js",
      "server.js",
      "license.js",
      "public/**/*",
      "!public/chat-window.html",
      "!public/js/chat-window.js",
      "templates/**/*",
      "node_modules/**/*",
      "!node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!node_modules/.cache/**/*"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "models",
        "to": "models",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/ffmpeg-static/**/*"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icons/icon.icns",
      "category": "public.app-category.productivity",
      "identity": "BYUNGHYUN LEE (UF9B4Q43XH)",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "notarize": {
        "teamId": "UF9B4Q43XH"
      },
      "publish": [
        "github"
      ]
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "dependencies": {
    "electron-updater": "^6.7.3",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "mammoth": "^1.11.0",
    "onnxruntime-node": "^1.20.1",
    "openai": "^6.15.0",
    "sql.js": "^1.13.0",
    "unzipper": "^0.12.3",
    "wav-decoder": "^1.3.0",
    "whisper-node": "^1.1.1",
    "xlsx": "^0.18.5",
    "xml2js": "^0.6.2"
  }
}
